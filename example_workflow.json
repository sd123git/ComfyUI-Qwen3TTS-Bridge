        }
      },
      "widgets_values": [
        "Role8: Create dialogue with Role Bank and Dialogue Node. Role 8 is the narrator in this example. The full composition flows out through the audio socket.\nRole3: Speech from each Role channel flows through to the matching stem. So the stem 3 output has all of my dialogue, without any other dialogue. \nRole1: Variations like mood or tone on the input, in case the script calls for a mood swing.\nRole2: Merge the outputs to build your character's dialogue track.\nRole4: The stem sockets aren't needed for every channel. Just use those to build your ref_audio as needed. This voice is off screen in this scene, so it's in the composition, with no ref audio out.\nRole3: These are just a few examples. Please let me know what else is handy!",
        "Qwen3-TTS-12Hz-1.7B-Base",
        0.4,
        0.8,
        0,
        0,
        "English",
        "subprocess",
        true,
        false,
        "bf16",
        365935844190083,
        "fixed",
        2048,
        0.8,
        20,
        1,
        1.05,
        "",
        "http://127.0.0.1:8190"
      ],
      "widgets_values_named": {
        "script": "Role8: Create dialogue with Role Bank and Dialogue Node. Role 8 is the narrator in this example. The full composition flows out through the audio socket.\nRole3: Speech from each Role channel flows through to the matching stem. So the stem 3 output has all of my dialogue, without any other dialogue. \nRole1: Variations like mood or tone on the input, in case the script calls for a mood swing.\nRole2: Merge the outputs to build your character's dialogue track.\nRole4: The stem sockets aren't needed for every channel. Just use those to build your ref_audio as needed. This voice is off screen in this scene, so it's in the composition, with no ref audio out.\nRole3: These are just a few examples. Please let me know what else is handy!",
        "model": "Qwen3-TTS-12Hz-1.7B-Base",
